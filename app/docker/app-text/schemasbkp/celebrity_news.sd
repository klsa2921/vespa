schema celebrity_news {
    document celebrity_news {
        field id type string {
            indexing: summary | attribute
            match: exact
        }

        field title type string {
            indexing: summary | index
        }

        field username type string {
            indexing: attribute | summary
            attribute: fast-search
        }

        field content type string {
            indexing: summary | index
            index: enable-bm25
        }

        field embedding type tensor<float>(d0[384]) {
            indexing: attribute
            attribute {
                distance-metric: euclidean
            }
        }
    }

    fieldset default {
        fields: id, title, content
    }

    rank-profile default {
        first-phase {
            expression: 5 * bm25(title) + 5 * bm25(content)
        }
    }

    rank-profile semantic inherits default {
        inputs {
            query(query_embedding) tensor<float>(d0[384])
        }

        first-phase {
            expression: 10 * closeness(embedding)
        }

        second-phase {
            expression: 2.5 * bm25(title) + 2.5 * bm25(content) + 10 * closeness(embedding)
        }
    }

    rank-profile hybrid inherits default {
        inputs {
            query(query_embedding) tensor<float>(d0[384])
        }

        first-phase {
            expression: 2.5 * bm25(title) + 2.5 * bm25(content) + 5 * closeness(embedding)
        }

        second-phase {
            expression: 2 * bm25(title) + 2 * bm25(content) + 6 * closeness(embedding)
        }
    }
}
